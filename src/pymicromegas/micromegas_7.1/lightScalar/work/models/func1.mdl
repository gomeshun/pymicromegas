x51x2          |I1b33+I2b33                                                                                                    % W-.f b~   t        coupling.
x52x0          |-(ydo*pow(2,-0.5))                                                                                             % Z.f  d~   d     coupling.
x53x0          |-(ys*pow(2,-0.5))                                                                                              % Z.f  s~   s     coupling.
x54x0          |-(yb*pow(2,-0.5))                                                                                              % Z.f  b~   b     coupling.
