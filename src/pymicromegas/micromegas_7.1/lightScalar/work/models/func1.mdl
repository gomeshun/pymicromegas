x65x0          |-(ym*pow(2,-0.5))                                                                                              % H    mu+  mu-   coupling.
x66x0          |-(ytau*pow(2,-0.5))                                                                                            % H    ta+  ta-   coupling.
x67x0          |0.5                                                                                                            % W+.f u~   d     coupling.
x67x1          |-I3b11+I4b11                                                                                                   % W+.f u~   d        coupling.
x67x2          |I3b11+I4b11                                                                                                    % W+.f u~   d        coupling.
x68x0          |0.5                                                                                                            % W+.f u~   s     coupling.
x68x1          |-I3b12+I4b12                                                                                                   % W+.f u~   s        coupling.
