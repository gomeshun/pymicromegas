DMsimp_s_spin0_mdmo
 Constraints
  Name         |> Expression                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    <|
%*slhaFound    |1+access("vars1.lha", 0)                                                                                       %Check whether LHA file is present.
%*rdSLHA       |if(slhaFound,slhaRead("vars1.lha", 0),-1)                                                                      %Read LHA file.
%cabi          |if(slhaFound,if(slhaValExists("CKMBLOCK",1,1),slhaVal("CKMBLOCK",0,1,1),cabiDef),cabiDef)                      %Cabibbo angle
%gSXr          |if(slhaFound,if(slhaValExists("DMINPUTS",1,1),slhaVal("DMINPUTS",0,1,1),gSXrDef),gSXrDef)                      %Xr-Y0 scalar coupling
%gSXc          |if(slhaFound,if(slhaValExists("DMINPUTS",1,2),slhaVal("DMINPUTS",0,1,2),gSXcDef),gSXcDef)                      %Xc-Y0 scalar coupling
%gSXd          |if(slhaFound,if(slhaValExists("DMINPUTS",1,3),slhaVal("DMINPUTS",0,1,3),gSXdDef),gSXdDef)                      %Xd-Y0 scalar coupling
%gPXd          |if(slhaFound,if(slhaValExists("DMINPUTS",1,4),slhaVal("DMINPUTS",0,1,4),gPXdDef),gPXdDef)                      %Xd-Y0 pseudoscalar coupling
%gSd11         |if(slhaFound,if(slhaValExists("DMINPUTS",1,5),slhaVal("DMINPUTS",0,1,5),gSd11Def),gSd11Def)                    %d-Y0 scalar coupling
%gSu11         |if(slhaFound,if(slhaValExists("DMINPUTS",1,6),slhaVal("DMINPUTS",0,1,6),gSu11Def),gSu11Def)                    %u-Y0 scalar coupling
%gSd22         |if(slhaFound,if(slhaValExists("DMINPUTS",1,7),slhaVal("DMINPUTS",0,1,7),gSd22Def),gSd22Def)                    %s-Y0 scalar coupling
%gSu22         |if(slhaFound,if(slhaValExists("DMINPUTS",1,8),slhaVal("DMINPUTS",0,1,8),gSu22Def),gSu22Def)                    %c-Y0 scalar coupling
%gSd33         |if(slhaFound,if(slhaValExists("DMINPUTS",1,9),slhaVal("DMINPUTS",0,1,9),gSd33Def),gSd33Def)                    %b-Y0 scalar coupling
%gSu33         |if(slhaFound,if(slhaValExists("DMINPUTS",1,10),slhaVal("DMINPUTS",0,1,10),gSu33Def),gSu33Def)                  %t-Y0 scalar coupling
%gPd11         |if(slhaFound,if(slhaValExists("DMINPUTS",1,11),slhaVal("DMINPUTS",0,1,11),gPd11Def),gPd11Def)                  %d-Y0 pseudoscalar coupling
%gPu11         |if(slhaFound,if(slhaValExists("DMINPUTS",1,12),slhaVal("DMINPUTS",0,1,12),gPu11Def),gPu11Def)                  %u-Y0 pseudoscalar coupling
%gPd22         |if(slhaFound,if(slhaValExists("DMINPUTS",1,13),slhaVal("DMINPUTS",0,1,13),gPd22Def),gPd22Def)                  %s-Y0 pseudoscalar coupling
%gPu22         |if(slhaFound,if(slhaValExists("DMINPUTS",1,14),slhaVal("DMINPUTS",0,1,14),gPu22Def),gPu22Def)                  %c-Y0 pseudoscalar coupling
%gPd33         |if(slhaFound,if(slhaValExists("DMINPUTS",1,15),slhaVal("DMINPUTS",0,1,15),gPd33Def),gPd33Def)                  %b-Y0 pseudoscalar coupling
%gPu33         |if(slhaFound,if(slhaValExists("DMINPUTS",1,16),slhaVal("DMINPUTS",0,1,16),gPu33Def),gPu33Def)                  %t-Y0 pseudoscalar coupling
%Lambda        |if(slhaFound,if(slhaValExists("DMINPUTS",1,17),slhaVal("DMINPUTS",0,1,17),LambdaDef),LambdaDef)                %cutoff scale
%gSg           |if(slhaFound,if(slhaValExists("DMINPUTS",1,18),slhaVal("DMINPUTS",0,1,18),gSgDef),gSgDef)                      %g-Y0 scalar coupling
%gPg           |if(slhaFound,if(slhaValExists("DMINPUTS",1,19),slhaVal("DMINPUTS",0,1,19),gPgDef),gPgDef)                      %g-Y0 pseudoscalar coupling
%aEWM1         |if(slhaFound,if(slhaValExists("SMINPUTS",1,1),slhaVal("SMINPUTS",0,1,1),aEWM1Def),aEWM1Def)                    %Inverse of the EW coupling constant at the Z pole
%Gf            |if(slhaFound,if(slhaValExists("SMINPUTS",1,2),slhaVal("SMINPUTS",0,1,2),GfDef),GfDef)                          %Fermi constant
%aS            |if(slhaFound,if(slhaValExists("SMINPUTS",1,3),slhaVal("SMINPUTS",0,1,3),aSDef),aSDef)                          %Strong coupling constant at the Z pole
%ymdo          |if(slhaFound,if(slhaValExists("YUKAWA",1,1),slhaVal("YUKAWA",0,1,1),ymdoDef),ymdoDef)                          %Down Yukawa mass
%ymup          |if(slhaFound,if(slhaValExists("YUKAWA",1,2),slhaVal("YUKAWA",0,1,2),ymupDef),ymupDef)                          %Up Yukawa mass
%yms           |if(slhaFound,if(slhaValExists("YUKAWA",1,3),slhaVal("YUKAWA",0,1,3),ymsDef),ymsDef)                            %Strange Yukawa mass
%ymc           |if(slhaFound,if(slhaValExists("YUKAWA",1,4),slhaVal("YUKAWA",0,1,4),ymcDef),ymcDef)                            %Charm Yukawa mass
%ymb           |if(slhaFound,if(slhaValExists("YUKAWA",1,5),slhaVal("YUKAWA",0,1,5),ymbDef),ymbDef)                            %Bottom Yukawa mass
%ymt           |if(slhaFound,if(slhaValExists("YUKAWA",1,6),slhaVal("YUKAWA",0,1,6),ymtDef),ymtDef)                            %Top Yukawa mass
%yme           |if(slhaFound,if(slhaValExists("YUKAWA",1,11),slhaVal("YUKAWA",0,1,11),ymeDef),ymeDef)                          %Electron Yukawa mass
%ymm           |if(slhaFound,if(slhaValExists("YUKAWA",1,13),slhaVal("YUKAWA",0,1,13),ymmDef),ymmDef)                          %Muon Yukawa mass
%ymtau         |if(slhaFound,if(slhaValExists("YUKAWA",1,15),slhaVal("YUKAWA",0,1,15),ymtauDef),ymtauDef)                      %Tau Yukawa mass
%MZ            |if(slhaFound,if(slhaValExists("MASS",1,23),slhaVal("MASS",0,1,23),MZDef),MZDef)                                %Mass of G0.
%Me            |if(slhaFound,if(slhaValExists("MASS",1,11),slhaVal("MASS",0,1,11),MeDef),MeDef)                                %Mass of e.
%MMU           |if(slhaFound,if(slhaValExists("MASS",1,13),slhaVal("MASS",0,1,13),MMUDef),MMUDef)                              %Mass of mu.
%MTA           |if(slhaFound,if(slhaValExists("MASS",1,15),slhaVal("MASS",0,1,15),MTADef),MTADef)                              %Mass of ta.
%MU            |if(slhaFound,if(slhaValExists("MASS",1,2),slhaVal("MASS",0,1,2),MUDef),MUDef)                                  %Mass of u.
%MC            |if(slhaFound,if(slhaValExists("MASS",1,4),slhaVal("MASS",0,1,4),MCDef),MCDef)                                  %Mass of c.
%MT            |if(slhaFound,if(slhaValExists("MASS",1,6),slhaVal("MASS",0,1,6),MTDef),MTDef)                                  %Mass of t.
%MD            |if(slhaFound,if(slhaValExists("MASS",1,1),slhaVal("MASS",0,1,1),MDDef),MDDef)                                  %Mass of d.
%MS            |if(slhaFound,if(slhaValExists("MASS",1,3),slhaVal("MASS",0,1,3),MSDef),MSDef)                                  %Mass of s.
%MB            |if(slhaFound,if(slhaValExists("MASS",1,5),slhaVal("MASS",0,1,5),MBDef),MBDef)                                  %Mass of b.
%MH            |if(slhaFound,if(slhaValExists("MASS",1,25),slhaVal("MASS",0,1,25),MHDef),MHDef)                                %Mass of H.
%MXr           |if(slhaFound,if(slhaValExists("MASS",1,5000511),slhaVal("MASS",0,1,5000511),MXrDef),MXrDef)                    %Mass of Xr.
%MXc           |if(slhaFound,if(slhaValExists("MASS",1,5000512),slhaVal("MASS",0,1,5000512),MXcDef),MXcDef)                    %Mass of Xc.
%MXd           |if(slhaFound,if(slhaValExists("MASS",1,5000521),slhaVal("MASS",0,1,5000521),MXdDef),MXdDef)                    %Mass of Xd.
%MY0           |if(slhaFound,if(slhaValExists("MASS",1,5000000),slhaVal("MASS",0,1,5000000),MY0Def),MY0Def)                    %Mass of Y0.
%WZ            |if(slhaFound,if(1+slhaDecayExists(23),slhaWidth(23),WZDef),WZDef)                                              %Width of G0.
%WW            |if(slhaFound,if(1+slhaDecayExists(24),slhaWidth(24),WWDef),WWDef)                                              %Width of GP.
%WT            |if(slhaFound,if(1+slhaDecayExists(6),slhaWidth(6),WTDef),WTDef)                                                %Width of t.
%WH            |if(slhaFound,if(1+slhaDecayExists(25),slhaWidth(25),WHDef),WHDef)                                              %Width of H.
%WY0           |if(slhaFound,if(1+slhaDecayExists(5000000),slhaWidth(5000000),WY0Def),WY0Def)                                  %Width of Y0.
CKM1x1         |cos(cabi)                                                                                                      % CKM-Matrix ( CKM1x1 )
CKM1x2         |sin(cabi)                                                                                                      % CKM-Matrix ( CKM1x2 )
CKM2x1         |-sin(cabi)                                                                                                     % CKM-Matrix ( CKM2x1 )
CKM2x2         |cos(cabi)                                                                                                      % CKM-Matrix ( CKM2x2 )
aEW            |pow(aEWM1,-1)                                                                                                  % Electroweak coupling contant
MW             |pow(pow(MZ,2)/2.+pow(-(aEW*Pi*pow(2,-0.5)*pow(Gf,-1)*pow(MZ,2))+pow(MZ,4)/4.,0.5),0.5)                         % W mass
EE             |2*pow(aEW,0.5)*pow(Pi,0.5)                                                                                     % Electric coupling constant
sw2            |1-pow(MW,2)*pow(MZ,-2)                                                                                         % Squared Sin of the Weinberg angle
cw             |pow(1-sw2,0.5)                                                                                                 % Cosine of the Weinberg angle
sw             |pow(sw2,0.5)                                                                                                   % Sine of the Weinberg angle
g1             |EE*pow(cw,-1)                                                                                                  % U(1)Y coupling constant at the Z pole
gw             |EE*pow(sw,-1)                                                                                                  % Weak coupling constant at the Z pole
vev            |2*MW*sw*pow(EE,-1)                                                                                             % Higgs vacuum expectation value
lam            |(pow(MH,2)*pow(vev,-2))/2.                                                                                     % Higgs quartic coupling
yb             |ymb*pow(2,0.5)*pow(vev,-1)                                                                                     % Down-type Yukawa couplings ( yb )
yc             |ymc*pow(2,0.5)*pow(vev,-1)                                                                                     % Up-type Yukawa couplings ( yc )
ydo            |ymdo*pow(2,0.5)*pow(vev,-1)                                                                                    % Down-type Yukawa couplings ( ydo )
ye             |yme*pow(2,0.5)*pow(vev,-1)                                                                                     % Lepton Yukawa couplings ( ye )
ym             |ymm*pow(2,0.5)*pow(vev,-1)                                                                                     % Lepton Yukawa couplings ( ym )
ys             |yms*pow(2,0.5)*pow(vev,-1)                                                                                     % Down-type Yukawa couplings ( ys )
yt             |ymt*pow(2,0.5)*pow(vev,-1)                                                                                     % Up-type Yukawa couplings ( yt )
ytau           |ymtau*pow(2,0.5)*pow(vev,-1)                                                                                   % Lepton Yukawa couplings ( ytau )
yup            |ymup*pow(2,0.5)*pow(vev,-1)                                                                                    % Up-type Yukawa couplings ( yup )
muH            |pow(lam*pow(vev,2),0.5)                                                                                        % Coefficient of the quadratic piece of the Higgs po
I1b11          |CKM1x1*ydo                                                                                                     % Abbreviation used in optimizatized FeynRules outpu
I1b12          |CKM2x1*ydo                                                                                                     % Abbreviation used in optimizatized FeynRules outpu
I1b21          |CKM1x2*ys                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I1b22          |CKM2x2*ys                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I1b33          |yb                                                                                                             % Abbreviation used in optimizatized FeynRules outpu
I2b11          |CKM1x1*yup                                                                                                     % Abbreviation used in optimizatized FeynRules outpu
I2b12          |CKM2x1*yc                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I2b21          |CKM1x2*yup                                                                                                     % Abbreviation used in optimizatized FeynRules outpu
I2b22          |CKM2x2*yc                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I2b33          |yt                                                                                                             % Abbreviation used in optimizatized FeynRules outpu
I3b11          |CKM1x1*yup                                                                                                     % Abbreviation used in optimizatized FeynRules outpu
I3b12          |CKM1x2*yup                                                                                                     % Abbreviation used in optimizatized FeynRules outpu
I3b21          |CKM2x1*yc                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I3b22          |CKM2x2*yc                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I3b33          |yt                                                                                                             % Abbreviation used in optimizatized FeynRules outpu
I4b11          |CKM1x1*ydo                                                                                                     % Abbreviation used in optimizatized FeynRules outpu
I4b12          |CKM1x2*ys                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I4b21          |CKM2x1*ydo                                                                                                     % Abbreviation used in optimizatized FeynRules outpu
I4b22          |CKM2x2*ys                                                                                                      % Abbreviation used in optimizatized FeynRules outpu
I4b33          |yb                                                                                                             % Abbreviation used in optimizatized FeynRules outpu
x1x0           |-6*lam                                                                                                         % Z.f  Z.f  Z.f  Z.f   coupling.
x2x0           |-2*lam                                                                                                         % Z.f  Z.f  W+.f W-.f  coupling.
x3x0           |-4*lam                                                                                                         % W+.f W+.f W-.f W-.f  coupling.
x4x0           |-2*lam                                                                                                         % Z.f  Z.f  H    H     coupling.
x5x0           |-2*lam                                                                                                         % W+.f W-.f H    H     coupling.
x6x0           |-6*lam                                                                                                         % H    H    H    H     coupling.
x7x0           |-2*lam*vev                                                                                                     % Z.f  Z.f  H     coupling.
x8x0           |-2*lam*vev                                                                                                     % W+.f W-.f H     coupling.
x9x0           |-6*lam*vev                                                                                                     % H    H    H     coupling.
x10x0          |gSXc*MXc                                                                                                       % ~xc  ~xcb y0    coupling.
x11x0          |gSXr*MXr                                                                                                       % ~xr  ~xr  y0    coupling.
x12x0          |2                                                                                                              % a    a    W+.f W-.f  coupling.
x13x0          |-1                                                                                                             % a    W+.f W-.f  coupling.
x14x0          |1                                                                                                              % a.C  W-.c W+    coupling.
x15x0          |-1                                                                                                             % a.C  W+.c W-    coupling.
x16x0          |-(vev*pow(sw,-1))/2.                                                                                           % W+.C a.c  W-.f  coupling.
x17x0          |1                                                                                                              % W+.C a.c  W-    coupling.
x18x0          |(vev*pow(sw,-2))/4.                                                                                            % W+.C W-.c Z.f   coupling.
x19x0          |-(vev*pow(sw,-2))/4.                                                                                           % W+.C W-.c H     coupling.
x20x0          |-1                                                                                                             % W+.C W-.c a     coupling.
x21x0          |-(cw*pow(sw,-1))                                                                                               % W+.C W-.c Z     coupling.
x22x0          |(vev*pow(cw,-1))/4.-(cw*vev*pow(sw,-2))/4.                                                                     % W+.C Z.c  W-.f  coupling.
x23x0          |cw*pow(sw,-1)                                                                                                  % W+.C Z.c  W-    coupling.
x24x0          |(vev*pow(sw,-1))/2.                                                                                            % W-.C a.c  W+.f  coupling.
x25x0          |-1                                                                                                             % W-.C a.c  W+    coupling.
x26x0          |-(vev*pow(sw,-2))/4.                                                                                           % W-.C W+.c Z.f   coupling.
x27x0          |-(vev*pow(sw,-2))/4.                                                                                           % W-.C W+.c H     coupling.
x28x0          |1                                                                                                              % W-.C W+.c a     coupling.
x29x0          |cw*pow(sw,-1)                                                                                                  % W-.C W+.c Z     coupling.
x30x0          |(vev*pow(cw,-1)*(-1+pow(cw,2)*pow(sw,-2)))/4.                                                                  % W-.C Z.c  W+.f  coupling.
x31x0          |-(cw*pow(sw,-1))                                                                                               % W-.C Z.c  W+    coupling.
x32x0          |-(vev*pow(cw,-1)*pow(sw,-2)*(pow(cw,2)+pow(sw,2)))/4.                                                          % Z.C  W-.c W+.f  coupling.
x33x0          |cw*pow(sw,-1)                                                                                                  % Z.C  W-.c W+    coupling.
x34x0          |(vev*pow(cw,-1)*(1+pow(cw,2)*pow(sw,-2)))/4.                                                                   % Z.C  W+.c W-.f  coupling.
x35x0          |-(cw*pow(sw,-1))                                                                                               % Z.C  W+.c W-    coupling.
x36x0          |-(vev*pow(cw,-2)*pow(sw,-2)*pow(pow(cw,2)+pow(sw,2),2))/4.                                                     % Z.C  Z.c  H     coupling.
x37x0          |yb*pow(2,-0.5)                                                                                                 % y0   b~   b     coupling.
x37x1          |gSd33                                                                                                          % y0   b~   b        coupling.
x37x2          |gPd33                                                                                                          % y0   b~   b        coupling.
x38x0          |yc*pow(2,-0.5)                                                                                                 % y0   c~   c     coupling.
x38x1          |gSu22                                                                                                          % y0   c~   c        coupling.
x38x2          |gPu22                                                                                                          % y0   c~   c        coupling.
x39x0          |ydo*pow(2,-0.5)                                                                                                % y0   d~   d     coupling.
x39x1          |gSd11                                                                                                          % y0   d~   d        coupling.
x39x2          |gPd11                                                                                                          % y0   d~   d        coupling.
x40x0          |ys*pow(2,-0.5)                                                                                                 % y0   s~   s     coupling.
x40x1          |gSd22                                                                                                          % y0   s~   s        coupling.
x40x2          |gPd22                                                                                                          % y0   s~   s        coupling.
x41x0          |yt*pow(2,-0.5)                                                                                                 % y0   t~   t     coupling.
x41x1          |gSu33                                                                                                          % y0   t~   t        coupling.
x41x2          |gPu33                                                                                                          % y0   t~   t        coupling.
x42x0          |yup*pow(2,-0.5)                                                                                                % y0   u~   u     coupling.
x42x1          |gSu11                                                                                                          % y0   u~   u        coupling.
x42x2          |gPu11                                                                                                          % y0   u~   u        coupling.
x43x0          |1                                                                                                              % y0   ~xdb ~xd   coupling.
x43x1          |gSXd                                                                                                           % y0   ~xdb ~xd      coupling.
x43x2          |gPXd                                                                                                           % y0   ~xdb ~xd      coupling.
x44x0          |1                                                                                                              % g.C  g.c  g     coupling.
x45x0          |1                                                                                                              % g    g    g     coupling.
x46x           |-pow(2,-0.5)                                                                                                   % g    g    g        coupling.
x47x0          |0.5                                                                                                            % W-.f d~   u     coupling.
x47x1          |-I1b11+I2b11                                                                                                   % W-.f d~   u        coupling.
x47x2          |I1b11+I2b11                                                                                                    % W-.f d~   u        coupling.
x48x0          |0.5                                                                                                            % W-.f d~   c     coupling.
x48x1          |-I1b12+I2b12                                                                                                   % W-.f d~   c        coupling.
x48x2          |I1b12+I2b12                                                                                                    % W-.f d~   c        coupling.
x49x0          |0.5                                                                                                            % W-.f s~   u     coupling.
