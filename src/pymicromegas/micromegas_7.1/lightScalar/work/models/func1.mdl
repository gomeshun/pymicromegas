csPi1          |2./9.*abs_theta_pi(QQ)*cos(arg_theta_pi(QQ))+7./9.*abs_gamma_pi(QQ)*cos(arg_gamma_pi(QQ))+7./9.*abs_delta_pi(QQ)*cos(arg_delta_pi(QQ))
csPi2          |2./9.*abs_theta_pi(QQ)*sin(arg_theta_pi(QQ))+7./9.*abs_gamma_pi(QQ)*sin(arg_gamma_pi(QQ))+7./9.*abs_delta_pi(QQ)*sin(arg_delta_pi(QQ))
