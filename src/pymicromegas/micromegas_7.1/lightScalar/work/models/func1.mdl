csK1           |2./9.*abs_theta_k(QQ)*cos(arg_theta_k(QQ))+7./9.*abs_gamma_k(QQ)*cos(arg_gamma_k(QQ))+7./9.*abs_delta_k(QQ)*cos(arg_delta_k(QQ))
