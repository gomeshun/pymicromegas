static double g1eff_int(double x,void *par_)
{  if(x==0 || x==1) return 0;
   geff_struct*par=par_;
   double p=-(3+par->mu/4)*log(x);
   double dpdx=(3+par->mu/4)/x;
   double e=sqrt(p*p+par->mu*par->mu);
   if(e>100) return 0;
   double den=exp(e - par->chi)+par->eta;
   return  dpdx*e*p*p/den/(2*M_PI*M_PI);
}


static double h1eff_int(double x,void *par_)   
{  if(x==0 || x==1) return 0;
   geff_struct*par=par_;
   double p=-(3+par->mu/4)*log(x);
   double dpdx= (3+par->mu/4)/x;
   double e=sqrt(p*p+par->mu*par->mu)-par->chi;
   if(e>100) return 0;
   double den=exp(e)+par->eta;

   long double f=1/den;
   if(par->eta<0)  return -dpdx*( f*logl(f) - (1+f)*logl(1+f))*p*p/(2*M_PI*M_PI) ; // bosons
   
    else           return  dpdx*(-f*logl(f) - (1-f)*logl(1-f))*p*p/(2*M_PI*M_PI) ; // fermions
//   return  (par->mu*par->mu+4./3.*p*p)*p*p/den/x/M_PI/M_PI/e;
}

static double h1eff_int_(double x,void *par_)   
{  if(x==0 || x==1) return 0;
   geff_struct*par=par_;
   double p=-(3+par->mu/4)*log(x);
   double dpdx= (3+par->mu/4)/x;
   double e=sqrt(p*p+par->mu*par->mu);
//   if(e>100) return 0;
   double f=1/(exp(e-par->chi)+par->eta);

   return   dpdx*p*p*(e -par->chi + p*p/3./e)*f/(2*M_PI*M_PI);
}



double g1eff_(double mu, double chi,int eta)     // contribution to energy density of one degree of freedom normalized on massless boson one.
                                                 // arguments: mu=mass/T, chi=(chemical potential)/T, eta=1 for bosons and -1 for fermions
                                                 // testinf points g1eff_(0,0,1)=1, g1eff_(0,0,-1)=7/8 
{ if(!isfinite(mu)) return 0;
  geff_struct par;
  par.eta=-eta;  //!!!
  par.mu=mu;
  par.chi=chi;
  int err;
  double r= simpson_arg(g1eff_int,&par, 0, 1,1E-4,NULL)/(M_PI*M_PI/30);
  return r;  
}



double h1eff__(double mu,double chi, int eta)   // contribution to entropy  density of one degree of freedom normalized on massless boson one.
                                               // arguments: mu=mass/T, chi=(chemical potential)/T, eta=1 for bosons and -1 for fermions
                                               // testinf points h1eff_(0,0,1)=1, h1eff_(0,0,-1)=7/8 

{ if(!isfinite(mu)) return 0;
  geff_struct par;
  par.eta=-eta;  //!!!
  par.mu=mu;
  par.chi=chi;
  int err;
  double r= simpson_arg(h1eff_int,&par, 0, 1,1E-4,NULL)/(2*M_PI*M_PI/45);

  return r;
}



double h1eff_(double mu,double chi, int eta)   // another implementation of h1eff

//geff:  dpdx*e*p*p/den/(2*M_PI*M_PI);
//peff:  dpdx*pow(p,4)/(e*den) 
//heff:  dpdx*p*p*(e /*-par->chi*/ + p*p/3./e)*f/(2*M_PI*M_PI);

{ if(!isfinite(mu)) return 0;
  geff_struct par;
  par.eta=-eta;  //!!!
  par.mu=mu;
  par.chi=chi;
  int err;
  double r= simpson_arg(h1eff_int_,&par, 0, 1,1E-4,NULL)/(2*M_PI*M_PI/45);

  return r;
}


// Particle - antiparticle number difference 

static double p1eff_int(double x,void *par_)   
{  if(x==0 || x==1) return 0;
   geff_struct*par=par_;
   double p=-(3+par->mu/4)*log(x);
   double dpdx= (3+par->mu/4)/x;
   double e=sqrt(p*p+par->mu*par->mu);;
   if(e>100) return 0;
   double den=exp(e-par->chi)+par->eta;   
   return  dpdx*pow(p,4)/(e*den) ; 
}

double p1eff(double mu,double chi,int eta)
{ geff_struct par;
  par.eta=-eta;  //!!!
  par.mu=mu;
  par.chi=chi;
  int err;
  double r= simpson_arg(p1eff_int,&par, 0, 1,1E-4,NULL)/(2*M_PI*M_PI)/(M_PI*M_PI/30);

  return r;

}


static double Nintegrand(double x, void* arg)
{ if(x==0||x==1) return 0;
  double* arg_=(double*) arg;
  double eps= arg_[0], chi=arg_[1],eta=arg_[2];
  double p=-(3+eps/4)*log(x);
  double dpdx= (3+eps/4)/x;
  
  double r=dpdx*p*p/(exp(sqrt(eps*eps+p*p)-chi)+eta);
  if(!isfinite(r) ) printf("x=%E r=%e\n",x,r);
  

  return dpdx*p*p/(exp(sqrt(eps*eps+p*p)-chi)+eta);   
} 

double Ntot(double mu, double chi, int eta)
{ double v[3];
  v[0]=mu; v[1]=chi; v[2]=-eta; 
  return 1/(2*M_PI*M_PI)*simpson_arg(Nintegrand, v,0,1,1E-4,NULL);
}
