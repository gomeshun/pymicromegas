static double g1eff_int(double x,void *par_)
{  if(x==0 || x==1) return 0;
   geff_struct*par=par_;
   double p=-(3+par->mu/4)*log(x);
   double dpdx=(3+par->mu/4)/x;
   double e=sqrt(p*p+par->mu*par->mu);
   if(e>100) return 0;
   double den;

//   if(par->eta==-1 && e<1E-8) den=e*(1+e/2); else 
   den=exp(e-par->chi)+par->eta;

   return  dpdx*e*p*p/den/(2*M_PI*M_PI);
}


static double h1eff_int(double x,void *par_)
{  if(x==0 || x==1) return 0;
   geff_struct*par=par_;
   double p=-(3+par->mu/4)*log(x);
   double dpdx= (3+par->mu/4)/x;
   double e=sqrt(p*p+par->mu*par->mu)-par->chi;
   if(e>100) return 0;
   double den;

   den=exp(e)+par->eta;

   double f=1/den;
   double r;
   if(par->eta<0)  r= -dpdx*( f*log(f) - (1+f)*log(1+f))*p*p/(2*M_PI*M_PI) ; // bosons
   
    else           r=  dpdx*(-f*log(f) -(1-f)*log(1-f))*p*p/(2*M_PI*M_PI) ; // fermions
//    printf("p=%E e=%E den=%E f=%E  r=%e\n",p,e,den,f, r);
   return r;
    
}


double g1eff(double mu, double chi,int eta)
{ if(!isfinite(mu)) return 0;
  geff_struct par;
  par.eta=-eta;  //!!!
  par.mu=mu;
  par.chi=chi;
  int err;
  double r= simpson_arg(g1eff_int,&par, 0, 1,1E-4,&err)/(M_PI*M_PI/30);
  if(err)
  { displayPlot("g1eff_int","x",0,1,0,1,"",0,g1eff_int,&par);
    exit(0);
  }
  return r;  
}


double h1eff(double mu,double chi, int eta)
{ if(!isfinite(mu)) return 0;
  geff_struct par;
  par.eta=-eta;  //!!!
  par.mu=mu;
  par.chi=chi;
  int err;
  double r= simpson_arg(h1eff_int,&par, 0, 1,1E-4,&err)/(2*M_PI*M_PI/45);
  if(err)
  {
     displayPlot("h1eff_int", "x",0,1,0,1,"",0,h1eff_int,&par);
     exit(0);
  }
  return r;
}

